# Environment: development | production
# In production the API refuses placeholder JWT_SECRET and CORS_ORIGINS=*
LUMINA_ENV=development

# Required in production — use a long random string (never commit real values)
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE_HOURS=24

# API listen port (Vite proxy + Docker use this)
PORT=58888
API_PORT=58888

# Shared SQLite (database.sqlite): FastAPI + Django use the same file.
# Optional override for Docker/Kubernetes:
# DATABASE_PATH=/data/database.sqlite

# Seed public demo_user account (default on in development, off in production)
SEED_DEMO_USER=1

# OpenAPI / Swagger UI at /swagger (default on in development, off in production)
ENABLE_DOCS=1

# Auth brute-force protection (per client IP)
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SEC=60

# Dev URLs (CORS / CSRF) — comma-separated, no spaces required
# Never use "*" in production when credentials are enabled
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:58888
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:58888
DJANGO_SECRET_KEY=lumina-django-dev-key-change-for-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional: link to Django admin from the UI
# VITE_DJANGO_ADMIN_URL=http://127.0.0.1:8001
