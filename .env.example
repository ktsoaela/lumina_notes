# .env.example
JWT_SECRET=your_super_secret_key_here
PORT=3000
GEMINI_API_KEY=

# Shared SQLite (database.sqlite): FastAPI + Django use the same file.
# Optional override for Docker/Kubernetes:
# DATABASE_PATH=/data/database.sqlite
# Dev URLs (CORS / CSRF) — comma-separated, no spaces required
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:58888
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:58888

# Optional: link to Django admin from the UI
# VITE_DJANGO_ADMIN_URL=http://127.0.0.1:8001
