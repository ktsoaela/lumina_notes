# Production (LUMINA_ENV=production refuses placeholder secrets and CORS_ORIGINS=*)
LUMINA_ENV=development

# --- Required in production ---
JWT_SECRET=                    # long random string
CORS_ORIGINS=https://app.example.com
DJANGO_SECRET_KEY=             # long random string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=app.example.com

# --- API ---
PORT=58888
API_PORT=58888
JWT_EXPIRE_HOURS=24
DATABASE_PATH=                 # e.g. /data/database.sqlite in Docker/k8s
SEED_DEMO_USER=0               # default off in production
ENABLE_DOCS=0                  # default off in production
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SEC=60

# --- Django (optional admin) ---
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# VITE_DJANGO_ADMIN_URL=https://app.example.com/admin

# --- Observability (optional) ---
# SENTRY_DSN=https://...@sentry.io/...
# pip install sentry-sdk  # only if using Sentry

# --- Local development defaults ---
# LUMINA_ENV=development
# JWT_SECRET=dev-only
# CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:58888
# SEED_DEMO_USER=1
# ENABLE_DOCS=1
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:58888
