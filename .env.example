# Production (LUMINA_ENV=production on a server requires Postgres via DATABASE_URL)
LUMINA_ENV=development

# --- Required in production (server) ---
JWT_SECRET=                    # long random string
DATABASE_URL=                  # postgresql://user:pass@host:5432/lumina
CORS_ORIGINS=https://app.example.com
DJANGO_SECRET_KEY=             # long random string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=app.example.com

# --- API ---
PORT=58888
API_PORT=58888
JWT_EXPIRE_HOURS=24
# SQLite only for desktop/dev (ignored when DATABASE_URL is postgres)
DATABASE_PATH=
SEED_DEMO_USER=0
ENABLE_DOCS=0
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SEC=60

# --- Django (optional admin) ---
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com

# --- Observability (optional) ---
# SENTRY_DSN=https://...@sentry.io/...

# --- Local development (SQLite) ---
# LUMINA_ENV=development
# JWT_SECRET=dev-only
# CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:58888
# SEED_DEMO_USER=1
# ENABLE_DOCS=1
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8001,http://127.0.0.1:58888

# --- Environments (Docker) ---
# charlie = development   → npm run compose:charlie -- up --build -d
# bravo   = test/QA       → npm run compose:bravo -- up --build -d
# alpha   = production    → npm run compose:alpha -- up --build -d
# Copy .env.<name>.example → .env.<name> as needed (alpha requires .env.alpha).
