<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Allow http:// LAN sync servers (e.g. http://192.168.x.x:58888) -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
