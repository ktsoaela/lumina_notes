{
  "name": "lumina-notes",
  "private": true,
  "version": "1.0.0",
  "description": "simple_markdown_notebook_application",
  "author": "Khotso Tsoaela <https://github.com/ktsoaela>",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "python run_project.py",
    "electron": "electron .",
    "dev:electron": "concurrently -k \"npm run dev:api\" \"npm run dev\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "dev:api": "python -m uvicorn app:app --host 127.0.0.1 --port 58888",
    "dev:django": "python manage.py runserver 127.0.0.1:8001",
    "build": "vite build",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_backend.ps1",
    "build:desktop": "scripts\\build_desktop.bat",
    "build:electron:app": "npm run build && npm run build:backend && electron-builder",
    "build:installer": "scripts\\build_installer.bat",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:django": "python manage.py test core.tests",
    "test:api": "python -m unittest tests.test_api -v",
    "test:e2e": "playwright test",
    "compose:charlie": "docker compose -p charlie -f docker-compose.yml -f docker-compose.charlie.yml",
    "compose:bravo": "docker compose -p bravo -f docker-compose.yml -f docker-compose.bravo.yml",
    "compose:alpha": "docker compose -p alpha -f docker-compose.yml -f docker-compose.alpha.yml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.12",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.546.0",
    "marked": "^17.0.6",
    "mermaid": "^11.14.0",
    "motion": "^12.23.24",
    "plotly.js": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "react-resizable-panels": "^4.9.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@types/plotly.js": "^3.0.10",
    "@types/react-plotly.js": "^2.6.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "vitest": {
    "environment": "node",
    "include": [
      "src/**/*.test.ts"
    ],
    "exclude": [
      "e2e/**",
      "node_modules/**",
      "dist/**"
    ]
  },
  "build": {
    "appId": "com.lumina.notes",
    "productName": "Lumina Notes",
    "directories": {
      "output": "release/electron"
    },
    "icon": "src/assets/book_colour_outline.png",
    "files": [
      "electron/**/*",
      "src/assets/**/*"
    ],
    "extraResources": [
      {
        "from": "release/LuminaApi",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
