{
  "name": "lumina-notes",
  "private": true,
  "version": "1.0.0",
  "description": "simple_markdown_notebook_application",
  "author": "Khotso Tsoaela <https://github.com/ktsoaela>",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "python run_project.py",
    "electron": "node scripts/run-electron.cjs .",
    "dev:electron": "concurrently -k \"npm run dev:api\" \"npm run dev\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_DEV=1 node scripts/run-electron.cjs .\"",
    "dev:api": "node -e \"const {spawnSync}=require('child_process'); const py=process.platform==='win32'?'python':'python3'; process.exit(spawnSync(py,['-m','uvicorn','app:app','--host','127.0.0.1','--port','58888'],{stdio:'inherit',shell:true}).status||0)\"",
    "dev:django": "node -e \"const {spawnSync}=require('child_process'); const py=process.platform==='win32'?'python':'python3'; process.exit(spawnSync(py,['manage.py','runserver','127.0.0.1:8001'],{stdio:'inherit',shell:true}).status||0)\"",
    "build": "vite build",
    "build:mobile": "cross-env VITE_BASE=./ vite build",
    "build:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_backend.ps1",
    "build:backend:posix": "bash scripts/build_backend.sh",
    "build:desktop": "scripts\\build_desktop.bat",
    "build:electron:app": "npm run build && npm run build:backend && electron-builder --win",
    "build:win": "npm run build && npm run build:backend && electron-builder --win",
    "build:mac": "npm run build && npm run build:backend:posix && electron-builder --mac",
    "build:installer": "scripts\\build_installer.bat",
    "cap:sync": "npm run build:mobile && npx cap sync android",
    "cap:open": "npx cap open android",
    "build:apk": "npm run cap:sync && node -e \"const {spawnSync}=require('child_process'); const g=process.platform==='win32'?'gradlew.bat':'./gradlew'; process.exit(spawnSync(g,['assembleDebug'],{cwd:'android',stdio:'inherit',shell:true}).status||0)\"",
    "preview": "vite preview",
    "kill": "node scripts/kill-ports.cjs",
    "kill-switch": "node scripts/kill-ports.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:django": "python manage.py test core.tests",
    "test:api": "python -m unittest tests.test_api -v",
    "test:e2e": "playwright test",
    "compose:charlie": "docker compose -p charlie -f docker-compose.yml -f docker-compose.charlie.yml",
    "compose:bravo": "docker compose -p bravo -f docker-compose.yml -f docker-compose.bravo.yml",
    "compose:alpha": "docker compose -p alpha -f docker-compose.yml -f docker-compose.alpha.yml"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.12",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.546.0",
    "marked": "^17.0.6",
    "mermaid": "^11.14.0",
    "motion": "^12.23.24",
    "plotly.js": "^3.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "react-resizable-panels": "^4.9.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@types/plotly.js": "^3.0.10",
    "@types/react-plotly.js": "^2.6.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "35.7.5",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1",
    "workbox-window": "^7.4.1"
  },
  "vitest": {
    "environment": "node",
    "include": [
      "src/**/*.test.ts"
    ],
    "exclude": [
      "e2e/**",
      "node_modules/**",
      "dist/**"
    ]
  },
  "build": {
    "appId": "com.lumina.notes",
    "productName": "Lumina Notes",
    "directories": {
      "output": "release/electron"
    },
    "icon": "src/assets/book_colour_outline.png",
    "files": [
      "electron/**/*",
      "src/assets/**/*"
    ],
    "extraResources": [
      {
        "from": "release/LuminaApi",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "LuminaNotes-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "LuminaNotes-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "LuminaNotes-${version}-Linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
